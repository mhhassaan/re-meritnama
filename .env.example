# Absolute origin for links inside outbound email. Must also be listed under
# Authentication -> URL Configuration -> Redirect URLs in the Supabase dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase, public ---------------------------------------------------------
# Publishable/anon keys are DESIGNED to ship to the browser. Data is protected by
# Row Level Security, not by hiding these — every Supabase app exposes them in
# its own page source.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy JWT anon key. Only for libraries that do not yet accept the publishable
# format; prefer the key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase, SECRET ---------------------------------------------------------
# BYPASSES Row Level Security entirely. Server-only: never import it into a
# client component, never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
